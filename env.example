# Copy to .env and fill in. NEVER commit .env.
FLASK_PORT=5000
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# Email OTP. If SMTP_* is empty, the OTP is printed in the API console (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OTP_VALIDITY_SECONDS=120

# Ollama (local LLM). If unreachable, rule-based recommendations are used.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Scanner
SCAN_TIMEOUT_SECONDS=10
PROXY_TIMING_THRESHOLD_MS=100
ENTROPY_THRESHOLD=3.5
TIMING_SAMPLES=5
VERIFY_TLS=1
